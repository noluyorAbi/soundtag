# All of these are optional. The product works with none of them set: paste a
# track link and the code image comes from Spotify's public scannable endpoint,
# or paste a scannable SVG and nothing leaves your machine at all.

# Only needed for search-by-song-title in the web UI. Server side only, never
# exposed to the browser. Create at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Absolute origin used for OG cards and share links. Vercel sets its own; this
# is for local runs and self-hosting.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
